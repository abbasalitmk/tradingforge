{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "esnext",
    "moduleResolution": "bundler", "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
