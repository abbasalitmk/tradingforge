# ── Mode ───────────────────────────────────────────────────────────────
# PAPER | SANDBOX | LIVE_ARMED | LIVE   (anything but PAPER needs explicit opt-in)
TF_MODE=PAPER
LIVE_TRADING=false

# ── Upstox app ─────────────────────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://<your-domain>/api/auth/callback
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_TOKEN=

# ── Webhook shared secrets (generate with: openssl rand -hex 32) ───────
TF_WEBHOOK_SECRET=
TF_ENGINE_URL=http://127.0.0.1:4000
# Required by both engine and web; no default. openssl rand -hex 32
TF_ENGINE_TOKEN=

# ── Dashboard login (HTTP Basic). REQUIRED in production: the web app
#    refuses to serve without it, because it controls real money.
TF_DASHBOARD_USER=
TF_DASHBOARD_PASSWORD=

# ── Infra ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://abba@localhost:5432/tradeforger
# Docker only: password for the bundled Postgres (the engine's position journal).
# The deploy script generates one on the VPS if missing.
POSTGRES_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# ── AI (Groq / xAI Grok / OpenAI) ───────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# ── Hostinger Deployment (VPS / MCP) ────────────────────────────────────
HOSTINGER_API_TOKEN=
HOSTINGER_VPS_HOST=
HOSTINGER_VPS_USER=root
HOSTINGER_DOMAIN=

# ── Risk ceilings (rupees) — always enforced regardless of sizing mode ─
TF_MAX_SPEND_PER_TRADE=10000
TF_MAX_DEPLOYED_CAPITAL=50000
TF_DAILY_LOSS_LIMIT_PCT=2

# ── F&O desk (docs/04-FNO.md) ──────────────────────────────────────────
# Long options only (max loss = premium). FUTURES is opt-in: gap risk is uncapped.
TF_FNO_ENABLED=false
TF_FNO_UNDERLYINGS=NIFTY,BANKNIFTY
TF_FNO_INSTRUMENT=OPTIONS
# Never buy expiry-day options.
TF_FNO_MIN_DTE=1
TF_FNO_TARGET_DELTA=0.5
TF_FNO_MAX_SPREAD_PCT=3
TF_FNO_MAX_PREMIUM_LOSS_PCT=35
TF_FNO_MAX_IV=60
TF_FNO_MAX_LOTS=2
# Exit a flat/losing option after N minutes (theta guard); 0 = off.
TF_FNO_TIME_STOP_MIN=30
TF_FNO_CHAIN_REFRESH_SEC=60
