# ── Mode ───────────────────────────────────────────────────────────────
# PAPER | SANDBOX | LIVE_ARMED | LIVE   (anything but PAPER needs explicit opt-in)
TF_MODE=PAPER
LIVE_TRADING=false

# ── Upstox app ─────────────────────────────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://<your-vercel-app>.vercel.app/api/auth/callback
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_SANDBOX_TOKEN=

# ── Webhook shared secrets (generate with: openssl rand -hex 32) ───────
TF_WEBHOOK_SECRET=
TF_ENGINE_URL=http://127.0.0.1:4000
TF_ENGINE_TOKEN=

# ── Infra ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://abba@localhost:5432/tradeforger
REDIS_URL=redis://127.0.0.1:6379

# ── AI (Groq — OpenAI-compatible) ──────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional fallback provider (Vercel AI Gateway, OpenAI-compatible).
# ~3x slower than Groq, so it is second. Used only when Groq returns nothing.
VERCEL_AI_KEY=
VERCEL_AI_MODEL=openai/gpt-4.1-mini
VERCEL_AI_BASE_URL=https://ai-gateway.vercel.sh/v1

# ── Risk ceilings (rupees) — always enforced regardless of sizing mode ─
TF_MAX_SPEND_PER_TRADE=10000
TF_MAX_DEPLOYED_CAPITAL=50000
TF_DAILY_LOSS_LIMIT_PCT=2
