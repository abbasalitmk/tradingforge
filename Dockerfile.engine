# Production container for Trading Engine Daemon
FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat curl

# Copy manifests and monorepo packages
COPY package*.json ./
COPY .npmrc ./
COPY apps/engine/package*.json ./apps/engine/
COPY packages/ ./packages/

RUN npm install --legacy-peer-deps --production=false

# Copy full application code
COPY . .

ENV NODE_ENV=production
ENV PORT=4000

EXPOSE 4000

CMD ["node", "--experimental-strip-types", "apps/engine/src/main.ts"]
